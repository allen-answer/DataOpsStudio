# docker-compose 工作目录的 .env 模板
#
# 用法:每个部署环境复制本文件为 .env,按需填值。.env 已 gitignore + deploy.sh
# rsync 排除,不会被本地空文件覆盖云端 secret。
#
# 本地 dev:**不需要 .env**(默认 dev 模式,docker-compose 用空值兜底)
# 云端 prod:必须配 DATAOPS_JWT_SECRET,否则启动 fail-fast(Wave 1 P0-1)

# 运行模式:dev / prod
# dev: Guard dry-run,允许 dev JWT key,默认本地用
# prod: Guard enforce(超阈值 abort),JWT secret 必填否则启动 RuntimeError
DATAOPS_ENV=prod

# JWT secret —— 生成命令:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# 改 secret 后所有现有用户 session 失效,挑无人用的时间切换
DATAOPS_JWT_SECRET=
