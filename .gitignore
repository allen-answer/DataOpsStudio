__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/
.deps/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
logs/
results/
*.log
.DS_Store
wheels/

# 默认忽略所有 .bat（多数是开发者本地 ad-hoc 脚本）；
# 例外放行：离线 release 包要用的 install.bat / start.bat 模板。
*.bat
!scripts/offline/*.bat

# Frontend build artefacts —— 由 CI / Dockerfile / release 脚本生成，不入库。
# 手写的 favicon.svg / icons.svg 等静态资源仍然保留。
static/spa/index.html
static/spa/assets/

# 离线 release zip 产物
DataOpsStudio-win-offline-*.zip

# Frontend local dependencies and build caches
node_modules/
frontend/**/node_modules/
frontend/**/.vite/
frontend/**/dist/
frontend/**/dist-ssr/
*.local

# Local editor / assistant state
.idea/
.vscode/*
!.vscode/extensions.json
.claude/

# Local config, archives, and scratch files
config/*.local.json
# Runtime config — each clone has its own datasources/tasks/jobs.
# Bootstrap with: cp config/datasources.example.json config/datasources.json
config/datasources.json
config/tasks.json
config/jobs.json
config/workflows.json
# Lineage 业务分组规则，每个 clone 自己 cp example 改造；example 仍跟踪。
config/lineage_group_rules.yml
config/lineage_group_rules.json
frontend.zip
*.tmp
*.bak

# Playwright MCP working dirs（工具产物，含截图缓存与 yaml snapshot）
.playwright-mcp/

# 临时验收/调试截图：归档请放 docs/screenshots/，否则不入库
/*.png

# 本地 openclaw / wsl 启动脚本（每个机器自己一份，不入库）
wsl_setup_openclaw.sh
scripts/*openclaw*
scripts/start-openclaw-*
scripts/install-openclaw-*
scripts/uninstall-openclaw-*

# Local skill / spec drafts — not for upstream
JOB.md
