# 默认忽略所有 .bat（多数是开发者本地 ad-hoc 脚本）；
# 例外放行：离线 release 包要用的 install.bat / start.bat 模板。
*.bat
!scripts/offline/*.bat

# Frontend build artefacts —— 由 CI / Dockerfile / release 脚本生成，不入库。
# 手写的 favicon.svg / icons.svg 等静态资源仍然保留。
static/spa/index.html
static/spa/assets/

# 离线 release zip 产物
DataOpsStudio-win-offline-*.zip

# Frontend local dependencies and build caches
node_modules/
frontend/**/node_modules/
frontend/**/.vite/
frontend/**/dist/
frontend/**/dist-ssr/
*.local

# Local editor / assistant state
.idea/
.vscode/*
!.vscode/extensions.json
.claude/

# Local config, archives, and scratch files
config/*.local.json
# Runtime config — each clone has its own datasources/tasks/jobs.
# Bootstrap with: cp config/datasources.example.json config/datasources.json
config/datasources.json
config/tasks.json
config/jobs.json
config/workflows.json
frontend.zip
wsl_setup_openclaw.sh
*.tmp
*.bak

# Local skill / spec drafts — not for upstream
JOB.md
