{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "schema:fetch": "curl -sf http://localhost:8010/openapi.json -o .openapi.json && openapi-typescript .openapi.json -o src/types/api-schema.ts && rm .openapi.json",
    "schema:from-file": "openapi-typescript .openapi.json -o src/types/api-schema.ts"
  },
  "dependencies": {
    "@antv/g6": "^5.1.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/vue-virtual": "^3.13.24",
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "^14.2.1",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.33.3",
    "cytoscape-dagre": "^2.5.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.22",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
